# Example Terraform variables file
# Copy this to terraform.tfvars and update with your values

aws_region = "eu-central-1"

# EC2 Instance Configuration
instance_type = "t3.medium"  # Development instance: 2 vCPU, 4GB RAM
volume_size   = 30            # GB - development size
enable_public_ip = true

# Security Configuration
# WARNING: For production, restrict admin_cidr to your IP (e.g., "YOUR.IP.ADDRESS/32")
allowed_admin_cidr  = "0.0.0.0/0"    # Admin ports (Prometheus, Grafana)
allowed_nginx_cidr  = "0.0.0.0/0"    # Nginx port (public access)

# AWS Key Pair - REQUIRED: Update with your key pair name
key_name = "your-aws-key-pair-name"

# Project Configuration
project_name = "nginx-metrics-demo"
environment  = "dev"

# Optional: Use specific AMI ID (leave empty to use latest Amazon Linux 2023)
# ami_id = "ami-xxxxxxxxxxxxxxxxx"

